{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jinshan-checkin-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinshan-checkin-staging",
      "database_id": "e08b82c1-e5f8-4274-892c-41d4c3aafd5f"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "jinshan-checkin-staging"
    }
  ]
}
