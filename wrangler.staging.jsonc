{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jinshan-checkin-staging",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-07-24",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinshan-checkin-staging",
      "database_id": "52cce165-851c-45fa-a85b-a68c4f095a6f"
    }
  ]
}
