{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jinshan20-checkin",
  "main": "../checkin-worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "vars": {
    "ENVIRONMENT": "production",
    "PROJECT_NAME": "jinshan20-checkin"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinshan20",
      "database_id": "1734a812-afc8-4c49-a1f1-f776c4b7ae69",
      "preview_database_id": "1734a812-afc8-4c49-a1f1-f776c4b7ae69"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "jinshan20"
    }
  ]
}
