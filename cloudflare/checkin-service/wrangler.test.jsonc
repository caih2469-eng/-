{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "jinshan20-checkin-test",
  "main": "../checkin-worker.js",
  "compatibility_date": "2026-07-24",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "secrets": {
    "required": ["MEDIA_SIGNING_SECRET"]
  },
  "vars": {
    "ENVIRONMENT": "test",
    "PROJECT_NAME": "jinshan20-checkin-test"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jinshan20-test",
      "database_id": "6d217199-0c06-45a3-8bdc-e32c36140957",
      "preview_database_id": "6d217199-0c06-45a3-8bdc-e32c36140957"
    }
  ],
  "r2_buckets": [
    {
      "binding": "UPLOADS",
      "bucket_name": "jinshan20-test"
    }
  ]
}
